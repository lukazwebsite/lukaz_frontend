# Backend API origin, used server-side by next.config.mjs rewrites
BASE_URL=

# Public site origin, server-side
BASE_URL_FRONTEND=

# Backend API origin, exposed to the browser
NEXT_PUBLIC_BASE_URL=

# Public site origin, exposed to the browser
NEXT_PUBLIC_BASE_URL_FRONTEND=

# Optional. Image host, when uploads are served from a different origin than
# NEXT_PUBLIC_BASE_URL. Leave empty to reuse the backend origin.
NEXT_PUBLIC_IMAGE_BASE_URL=
