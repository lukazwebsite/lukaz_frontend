# Local development: Laravel backend via `php artisan serve` (port 8000)

# Backend API origin, used server-side by next.config.mjs rewrites
BASE_URL=http://127.0.0.1:8000

# Public site origin, server-side
BASE_URL_FRONTEND=http://localhost:3000

# From nextjs client component to get env variable we have to add (NEXT_PUBLIC ) this prefix
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BASE_URL_FRONTEND=http://localhost:3000

# Image host. Tried first: production, which holds nearly every upload. The
# local public/ folder has only a handful of files, so pointing this at
# localhost breaks most product images.
# Leave unset in production to reuse NEXT_PUBLIC_BASE_URL.
NEXT_PUBLIC_IMAGE_BASE_URL=https://admin.lukazshop.com

# Retried when production has no such file, covering images uploaded through the
# local admin that were never deployed (category menuImage, etc.).
# Leave unset in production, where there is no second host.
NEXT_PUBLIC_IMAGE_FALLBACK_URL=http://127.0.0.1:8000
